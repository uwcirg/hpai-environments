# Example docker-compose environment file
# Copy to confidentialbackend.env and modify as necessary
# https://docs.docker.com/compose/env-file/

# Variables defined in this file will only be available to containers/images
# ie not for interpolation in docker-compose YAML files

# When defined, all upstream FHIR responses hit given logfile
#FHIR_RESOURCES_LOGFILE=/var/log/confidentialbackend/fhir-response.log

# coding systems used on respective FHIR servers for MRN identifiers
# keep LAUNCH_FHIR_MRN_SYSTEM in sync with REACT_APP_LAUNCH_FHIR_MRN_SYSTEM in summary.env
APP_FHIR_MRN_SYSTEM=
LAUNCH_FHIR_MRN_SYSTEM=


# Keycloak OIDC client secret, must match __KEYCLOAK_FEMR_REALM_HPAI_OPENID_CLIENT_SECRET
SOF_CLIENT_SECRET=

# unique to install
SECRET_KEY=
