{
  "resourceType": "Bundle",
  "type": "transaction",
  "entry": [
    {
      "resource": {
        "resourceType": "AccessPolicy",
        "id": "disable-auth",
        "engine": "matcho",
        "matcho": {
          "user": "nil?"
        },
        "description": "allow unauthenticated FHIR access"
      },
      "request": {
        "method": "PUT",
        "url": "/AccessPolicy/disable-auth"
      }
    },
    {
      "resource": {
        "resourceType": "Questionnaire",
        "id": "sample-questionnaire",
        "url": "http://example.org/questionnaire/sample",
        "title": "Sample Patient Registration",
        "status": "active",
        "item": [
          {
            "linkId": "name",
            "type": "string",
            "text": "Full Name",
            "required": true
          },
          {
            "linkId": "age",
            "type": "integer",
            "text": "Age"
          },
          {
            "linkId": "consent",
            "type": "boolean",
            "text": "I consent to treatment"
          },
          {
            "linkId": "email",
            "type": "string",
            "text": "Email Address"
          }
        ]
      },
      "request": {
        "method": "PUT",
        "url": "/Questionnaire/sample-questionnaire"
      }
    }
  ]
}
